# Local API URL used by the web client. This is not a secret.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database values are placeholders for the Milestone 2 local Compose stack.
POSTGRES_DB=indy_accessibility
POSTGRES_USER=indy_accessibility
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional complete URL; when omitted the ETL derives one from POSTGRES_*.
DATABASE_URL=

# Optional for ACS acquisition. Request a free key from the Census Bureau and
# set it only in your untracked local .env or shell environment.
CENSUS_API_KEY=
