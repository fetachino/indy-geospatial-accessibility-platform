# Local API URL used by the web client. This is not a secret.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Database values are placeholders for the Milestone 2 local Compose stack.
POSTGRES_DB=indy_accessibility
POSTGRES_USER=indy_accessibility
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Optional for ACS acquisition. Request a free key from the Census Bureau and
# set it only in your untracked local .env or shell environment.
CENSUS_API_KEY=
